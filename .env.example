# docker-compose.yml settings. Copy to .env next to docker-compose.yml (never commit it).

# Must match the password Postgres was first created with (POSTGRES_PASSWORD only applies once).
DB_PASSWORD=

# Clerk instance URL; the backend verifies login tokens against it. Required.
CLERK_ISSUER_URI=https://your-instance.clerk.accounts.dev

# Only needed where the web image is built (baked into the JS at build time).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Optional: comma-separated Clerk user ids promoted to ADMIN on login.
ADMIN_CLERK_USER_IDS=

# Optional: AI features stay off without it.
# OPENAI_API_KEY=
