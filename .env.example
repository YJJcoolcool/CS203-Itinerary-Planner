# Clerk application keys
# Copy this file to .env and replace each placeholder with your own values.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# React + Vite frontend (planned)
# This is safe to expose to the browser because it is a publishable key.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Spring Boot uses this issuer to validate Clerk session JWTs.
CLERK_ISSUER_URI=https://your-instance.clerk.accounts.dev
