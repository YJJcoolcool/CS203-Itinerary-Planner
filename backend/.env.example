# Clerk application keys
# Copy this file to .env and replace each placeholder with your own values.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Spring Boot uses this issuer to validate Clerk session JWTs.
CLERK_ISSUER_URI=https://your-instance.clerk.accounts.dev

# OSM integration (optional; sensible defaults exist in application.properties)
# APP_OSM_USER_AGENT=ItineraryPlanner/1.0 (+https://github.com/CS203-Itinerary-Planner)
# APP_OSM_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# APP_OSM_OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter

# AI integration (optional; without a key the app boots and uses deterministic ranking)
# Any OpenAI-compatible endpoint works via OPENAI_BASE_URL.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_MODEL=gpt-4o-mini

# Semantic ranking (optional; must match the model/dimensions used to embed the index)
# APP_RAG_ENABLED=true
# APP_RAG_MODEL=text-embedding-3-small
# APP_RAG_DIMENSIONS=512

# Postgres password for the dev/prod profiles (dev reaches EC2 via the SSH tunnel on localhost:5433).
DB_PASSWORD=

# Proactive rain polling (base default is off; set true for local polling).
# APP_POLLING_ENABLED=true
# APP_POLLING_ACTIVITY_DELAY_MS=600000
